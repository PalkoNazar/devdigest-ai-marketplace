{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/readonly-bash.mjs\" sdd-engineering:spec-creator sdd-engineering:implementation-planner sdd-engineering:plan-verifier"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/spec-write-scope.mjs\" sdd-engineering:spec-creator"
          }
        ]
      }
    ]
  }
}
